.section-heading{display:flex;align-items:center;gap:15rpx;margin:38rpx 0 22rpx}.step{font-size:21rpx;color:#a69bbd;font-weight:600}.scenes{display:flex;gap:14rpx}.scene{flex:1;background:#fff;border:2rpx solid #eeebf4;border-radius:24rpx;padding:24rpx 6rpx;text-align:center}.scene.selected{background:#f0eafb;border-color:#ae99e3}.scene-icon{font-size:40rpx;line-height:1.2;color:#8f79bd;margin-bottom:12rpx}.scene-name{font-size:25rpx;font-weight:600}.scene-hint{font-size:19rpx;color:#9a90ac;margin-top:9rpx}.people{display:flex;align-items:center;justify-content:space-between;padding:28rpx}.person{flex:1;min-width:0}.person:last-child{text-align:right}.type{font-size:34rpx;font-weight:600;margin-top:12rpx;letter-spacing:1rpx}.chevron{font-size:23rpx;color:#a79bb8}.swap{background:#f6f3fb;border-radius:50%;color:#a38abd;font-size:30rpx;width:68rpx;height:68rpx;padding:9rpx}.tabs{display:flex;background:#eeebf4;border-radius:18rpx;padding:7rpx;gap:8rpx}.tab{flex:1;font-size:25rpx;background:transparent;color:#95899f;padding:16rpx 6rpx;border-radius:13rpx}.tab.active{background:#fff;color:#7560a5;box-shadow:0 3rpx 8rpx #37215708}.editor{margin-top:18rpx;padding:26rpx}.editor textarea{width:100%;height:240rpx;font-size:29rpx;line-height:1.8;color:#393044}.placeholder{color:#b2aaba}.editor .row{border-top:1rpx solid #f4f1f7;padding-top:12rpx}.extras{padding:25rpx 28rpx;margin-top:18rpx}.extras .label{font-size:25rpx}.extra-fields{padding-top:25rpx}.extra-fields input{background:#f8f6fb;border-radius:14rpx;margin:12rpx 0 24rpx;padding:20rpx;font-size:24rpx;height:80rpx}.generate{margin-top:30rpx}
.demo-warning{margin-top:18rpx;padding:18rpx 20rpx;border-radius:14rpx;background:#fff7e8;color:#8b6429;font-size:22rpx;line-height:1.55}
