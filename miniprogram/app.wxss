page{background:#f8f7fc;color:#272337;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,button,textarea,input{box-sizing:border-box}button::after{border:0}button{font-size:28rpx;margin:0;line-height:1.5}button[disabled]{opacity:.5}.page{padding:36rpx 36rpx calc(48rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#8b7faa;font-weight:600}.title{font-size:56rpx;line-height:1.3;font-weight:650;letter-spacing:-2rpx;margin:18rpx 0}.subtitle{font-size:26rpx;line-height:1.8;color:#888195}.card{background:#fff;border:1rpx solid #efedf5;border-radius:32rpx;padding:30rpx;margin-top:26rpx;box-shadow:0 8rpx 32rpx #37215704}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.label{font-size:28rpx;font-weight:600}.muted{font-size:23rpx;color:#9991a5;line-height:1.6}.primary{background:#7860cd;color:#fff;border-radius:24rpx;padding:25rpx 20rpx;font-weight:600;box-shadow:0 10rpx 24rpx #7860cd25}.secondary{color:#7660bc;background:#f0ecfa;border-radius:18rpx;padding:18rpx 24rpx}.note{font-size:22rpx;line-height:1.7;color:#9991a5;text-align:center;margin-top:26rpx}.banner{border-radius:18rpx;background:#efebfa;color:#79669c;font-size:23rpx;line-height:1.7;padding:20rpx 24rpx;margin-top:26rpx}.error{color:#a34656;background:#fff0f1;border-radius:16rpx;padding:20rpx;margin:20rpx 0;font-size:25rpx}.pill{font-size:22rpx;color:#8570b5;background:#f2eefa;padding:8rpx 18rpx;border-radius:30rpx}.text-button{background:transparent;color:#8471b2;padding:8rpx 0;font-size:24rpx}
